# Copy to .env, then edit .env only. Never publish keys or private documents.
CHAT_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Exact model ID from your OpenRouter account; no universal free model is assumed.
OPENROUTER_MODEL=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
DATABRICKS_CHAT_ENDPOINT=
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
CHROMA_PERSIST_DIR=data/chroma_db
CHROMA_COLLECTION_NAME=insurance_docs
LEXICAL_INDEX_PATH=data/lexical_search.db
SEARCH_ANALYTICS_DB=data/search_analytics.db
PDF_UPLOAD_DIR=data/pdfs
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_K=20
HYBRID_RRF_K=60
HYBRID_VECTOR_WEIGHT=1.0
HYBRID_LEXICAL_WEIGHT=1.0
MAX_VECTOR_DISTANCE=0.65
FEEDBACK_SOURCE_BOOST=0.15
CONTEXT_TOKENS=3500
MAX_ANSWER_TOKENS=800
REQUEST_TIMEOUT=60
SEARCH_ANALYTICS_ENABLED=false
ANALYTICS_RETENTION_DAYS=30
OCR_ENABLED=false
LOG_LEVEL=INFO
